# Copy to .env.local for local work, and set the same names in the host's
# environment settings (Vercel: Project Settings, Environment Variables) for
# every environment that builds, Production and Preview. NEXT_PUBLIC_ values are
# inlined at build time, so a build without them fails.

# Supabase dashboard, Project Settings, API. Both values are public by design.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# The site's own origin, for canonical URLs, the sitemap and share cards.
# Defaults to the Vercel URL, so set it when the domain changes.
NEXT_PUBLIC_SITE_URL=https://makerbhawan-dev.vercel.app

# Optional: Google Analytics measurement id. Only loads after cookie consent.
# NEXT_PUBLIC_GA_ID=

# Never add the Supabase service role key. Nothing here reads it.
